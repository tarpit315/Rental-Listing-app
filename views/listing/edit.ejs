<% layout("layout/plate") %>
<link rel="stylesheet" href="/style.css">
<div class="form-wrapper">
  <div class="form-card">
    <h1>Edit Listing</h1>

    <form method="POST" action="/listing/<%= listing._id %>?_method=PUT">

      <div class="group">
        <label>Title</label>
        <input type="text" name="listing[title]" value="<%= listing.title %>" required>
      </div>

      <div class="group">
        <label>Description</label>
        <textarea name="listing[description]" required><%= listing.description %></textarea>
      </div>

      <div class="group">
        <label>Image URL</label>
        <input type="text" name="listing[url]" value="<%= listing.url %>">
      </div>

      <div class="group two-col">
        <div>
          <label>Price</label>
          <input type="number" name="listing[price]" value="<%= listing.price %>" required>
        </div>

        <div>
          <label>Location</label>
          <input type="text" name="listing[location]" value="<%= listing.location %>" required>
        </div>
      </div>

      <div class="group">
        <label>Country</label>
        <input type="text" name="listing[country]" value="<%= listing.country %>" required>
      </div>

      <button class="submit-btn">Update Listing</button>
    </form>

    <a class="back-link" href="/listing/<%= listing._id %>">← Back to Details</a>
  </div>
</div>