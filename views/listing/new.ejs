<% layout("layout/plate") %>
<link rel="stylesheet" href="/style.css">
<div class="form-wrapper">
  <div class="form-card">
    <h1>Create New Listing</h1>

    <form action="/listing" method="POST" class="needs-validation" novalidate>

      <div class="group">
        <label>Title</label>
        <input type="text" name="listing[title]"  class="form-control" required>
        <div class="valid-feedback">
          Looks good!
        </div>
      </div>

      <div class="group">
        <label>Description</label>
        <textarea name="listing[description]"  class="form-control" required></textarea>
        <div class="valid-feedback">
          Nice Description!
        </div>
      </div>

      <div class="group">
        <label>Image URL</label>
        <input type="text" name="listing[url]">
      </div>

      <div class="group two-col">
        <div>
          <label>Price</label>
          <input type="number" name="listing[price]" class="form-control" required>
          <div class="valid-feedback">
            DAMN!
          </div>
        </div>

        <div>
          <label>Location</label>
          <input type="text" name="listing[location]"   class="form-control" required>
          <div class="valid-feedback">
            Location Looks good!
          </div>
        </div>
      </div>

      <div class="group">
        <label>Country</label>
        <input type="text" name="listing[country]"  class="form-control" required>
        <div class="valid-feedback">
          Fabulous Country!
        </div>
      </div>

      <button class="submit-btn">Create Listing</button>
    </form>
  </div>
</div>